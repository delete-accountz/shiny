{
  "name": "shiny-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "validate:release": "node scripts/validate-release.mjs --preview",
    "validate:production": "node scripts/validate-release.mjs --production"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "bcrypt": "^6.0.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
