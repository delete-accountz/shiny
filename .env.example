# Runtime
# NODE_ENV is supplied by Next.js/Vercel; keep this line as local documentation only.
NODE_ENV=development

# Production storage mode. Database mode fails closed when DATABASE_URL is missing; no JSON fallback is allowed.
DATABASE_REQUIRED=true
SHINY_STORAGE_MODE=database
DATABASE_URL=replace-me-never-commit
SESSION_HMAC_SECRET=replace-me-with-a-random-32-byte-secret
WEBHOOK_ENCRYPTION_KEY=replace-me-with-a-random-32-byte-secret
CRON_SECRET=replace-me-with-a-random-32-byte-secret
RECONCILIATION_AUTOMATION_ENABLED=false

# Administrative authentication - server-only
ADMIN_USER=replace-me
ADMIN_ACCESS_KEY=replace-me
ADMIN_ACCESS_LEVEL=OWNER

# Promisse - server-only
PROMISSE_API_BASE_URL=https://api.promisse.com.br
PROMISSE_API_KEY=replace-me
PROMISSE_WEBHOOK_SECRET=replace-me
PROMISSE_WEBHOOK_URL=https://example.com/Api/Webhooks/Promisse

# hCaptcha
# Site key is public/client-safe; secret is server-only.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=replace-with-public-site-key
HCAPTCHA_SECRET_KEY=replace-me

# Proxy trust - server-only. Keep false unless a trusted proxy is configured.
TRUSTED_PROXY=false
TRUSTED_PROXY_HEADER=x-real-ip
